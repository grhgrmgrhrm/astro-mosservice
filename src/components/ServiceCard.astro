---
import { ArrowRight, Clock, ShieldCheck, Tag } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  image: string;
  priceFrom: string;
  executionTime: string;
  category: string;
}

const { title, description, slug, image, priceFrom, executionTime, category } = Astro.props;

// Конвертируем путь к картинке в card-версию (480x320) для адаптивного srcset
const cardImage = image.replace(/\.webp$/, '-card.webp');

const categoryLabels: Record<string, string> = {
  'common-rail': 'Common Rail',
  'gasoline': 'Бензиновые',
  'tnvd': 'ТНВД',
  'brands': 'По брендам',
  'diagnostics': 'Диагностика',
  'commercial': 'Коммерческие'
};
---

<article class="bg-dark-900 rounded-2xl overflow-hidden border border-slate-800/80 hover:border-primary-500/50 transition-all duration-300 flex flex-col group hover:-translate-y-1 hover:shadow-xl hover:shadow-primary-500/10">
  <div class="relative h-48 overflow-hidden bg-slate-950">
    <img
      src={cardImage}
      alt={title}
      width="480"
      height="320"
      class="w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-90 group-hover:opacity-100"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-transparent to-transparent"></div>
    <span class="absolute top-3 left-3 bg-dark-950/80 backdrop-blur border border-slate-700/60 text-primary-400 font-semibold px-2.5 py-1 rounded-md text-[11px] uppercase tracking-wider">
      {categoryLabels[category] || category}
    </span>
  </div>

  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-base font-bold text-white group-hover:text-primary-400 transition leading-snug mb-2 line-clamp-2">
        <a href={`/uslugi/${slug}`}>
          {title}
        </a>
      </h3>
      <p class="text-xs text-slate-400 leading-relaxed line-clamp-3 mb-4">
        {description}
      </p>
    </div>

    <div>
      <div class="flex items-center justify-between pt-3 border-t border-slate-800 text-xs text-slate-300 mb-4">
        <div class="flex items-center space-x-1 text-emerald-400 font-semibold">
          <Tag class="w-3.5 h-3.5" />
          <span>{priceFrom}</span>
        </div>
        <div class="flex items-center space-x-1 text-slate-400">
          <Clock class="w-3.5 h-3.5 text-accent-500" />
          <span>{executionTime}</span>
        </div>
      </div>

      <a 
        href={`/uslugi/${slug}`} 
        class="w-full bg-slate-800 group-hover:bg-primary-600 text-slate-200 group-hover:text-slate-950 font-bold py-2.5 px-4 rounded-xl text-xs flex items-center justify-center space-x-2 transition duration-300"
      >
        <span>Подробнее об услуге</span>
        <ArrowRight class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition" />
      </a>
    </div>
  </div>
</article>
