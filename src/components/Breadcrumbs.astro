---
import { ChevronRight, Home } from 'lucide-astro';
import { siteConfig } from '@/data/siteConfig';
import { url } from '@/utils/url';

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const schemaItems = [
  { "@type": "ListItem", "position": 1, "name": "Главная", "item": siteConfig.url },
  ...items.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 2,
    "name": item.label,
    "item": item.href ? `${siteConfig.url}${item.href}` : siteConfig.url
  }))
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": schemaItems
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav class="flex items-center space-x-2 text-xs text-slate-400 py-3 mb-6 overflow-x-auto">
  <a href={url('/')} class="flex items-center space-x-1 hover:text-primary-500 transition shrink-0">
    <Home class="w-3.5 h-3.5" />
    <span>Главная</span>
  </a>
  {items.map(item => (
    <div class="flex items-center space-x-2 shrink-0">
      <ChevronRight class="w-3 h-3 text-slate-600" />
      {item.href ? (
        <a href={item.href} class="hover:text-primary-500 transition">{item.label}</a>
      ) : (
        <span class="text-slate-200 font-medium">{item.label}</span>
      )}
    </div>
  ))}
</nav>
