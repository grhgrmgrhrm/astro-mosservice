---
import { siteConfig } from '@/data/siteConfig';
import { Phone, MapPin, Clock, Navigation, ArrowUpRight } from 'lucide-astro';
---

<section class="relative bg-gradient-to-br from-dark-950 via-dark-900 to-dark-950 border-t border-slate-800/80 py-12 px-4 overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="bg-dark-900/95 backdrop-blur border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Column: Fast Call & Info -->
        <div class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center space-x-2 bg-primary-500/10 border border-primary-500/30 text-primary-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
            <Clock class="w-3.5 h-3.5" />
            <span>Быстрый контакт & Проезд</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
            Нужен срочный ремонт или консультация?
          </h2>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Позвоните мастеру-приемщику прямо сейчас или проложите маршрут в удобном навигаторе.
          </p>

          <!-- Primary Call Button -->
          <a 
            href={`tel:${siteConfig.phoneClean}`}
            class="flex items-center justify-between bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-accent-500 text-slate-950 font-black p-4 rounded-2xl shadow-xl shadow-primary-600/20 transition transform hover:-translate-y-0.5 group"
          >
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-xl bg-slate-950/20 flex items-center justify-center">
                <Phone class="w-5 h-5 text-slate-950" />
              </div>
              <div class="text-left">
                <span class="text-[11px] uppercase tracking-wider block opacity-80 font-bold">Позвонить мастеру</span>
                <span class="text-base sm:text-lg font-black leading-none">{siteConfig.phonePrimary}</span>
              </div>
            </div>
            <ArrowUpRight class="w-5 h-5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition" />
          </a>
        </div>

        <!-- Middle Column: Working Hours & Messengers -->
        <div class="lg:col-span-3 space-y-4 bg-dark-950 p-5 rounded-2xl border border-slate-800/80">
          <div>
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Режим работы</span>
            <div class="flex items-center space-x-2 text-xs font-bold text-emerald-400">
              <Clock class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>{siteConfig.workingHours}</span>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-800">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2">Мессенджеры</span>
            <div class="flex items-center space-x-2 text-xs font-medium">
              <a href={siteConfig.social.viber} class="px-3 py-1.5 rounded-lg bg-purple-950 text-purple-300 border border-purple-800/50 hover:bg-purple-900 transition">Viber</a>
              <a href={siteConfig.social.telegram} class="px-3 py-1.5 rounded-lg bg-sky-950 text-sky-300 border border-sky-800/50 hover:bg-sky-900 transition">Telegram</a>
              <a href={siteConfig.social.whatsapp} class="px-3 py-1.5 rounded-lg bg-emerald-950 text-emerald-300 border border-emerald-800/50 hover:bg-emerald-900 transition">WhatsApp</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Navigation Routes (Google & Yandex Maps) -->
        <div class="lg:col-span-4 space-y-3 bg-dark-950 p-5 rounded-2xl border border-slate-800/80">
          <a 
            href={siteConfig.maps.yandex} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-start space-x-2 hover:text-primary-400 transition"
          >
            <MapPin class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" />
            <span class="text-xs font-bold text-slate-200">{siteConfig.address.full}</span>
          </a>

          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block pt-1">Составить маршрут:</span>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            <a 
              href={siteConfig.maps.yandex} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-center space-x-2 bg-red-950/80 hover:bg-red-900 text-red-200 border border-red-800/60 font-bold py-2.5 px-3 rounded-xl transition group"
            >
              <Navigation class="w-3.5 h-3.5 text-red-400 group-hover:rotate-12 transition" />
              <span>Яндекс Карты</span>
            </a>

            <a 
              href={siteConfig.maps.google} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-center space-x-2 bg-blue-950/80 hover:bg-blue-900 text-blue-200 border border-blue-800/60 font-bold py-2.5 px-3 rounded-xl transition group"
            >
              <Navigation class="w-3.5 h-3.5 text-blue-400 group-hover:rotate-12 transition" />
              <span>Google Maps</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
