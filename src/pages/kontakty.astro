---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/data/siteConfig';
import { MapPin, Phone, Mail, Clock, Navigation, Building2, CreditCard, FileText, CheckCircle2 } from 'lucide-astro';

const mapWidgetUrl = `https://yandex.ru/map-widget/v1/?ll=${siteConfig.address.longitude}%2C${siteConfig.address.latitude}&z=16&pt=${siteConfig.address.longitude},${siteConfig.address.latitude},pm2rdm`;
---

<Layout title="Контакты и реквизиты | СТО МосСервис в Минске" description="Контактная информация СТО МосСервис: телефоны, адрес в Минске (Передовая ул., 6, корп. 12), карта проезда, режим работы и реквизиты ООО УпакПринтСервис.">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'Контакты и реквизиты' }]} />

    <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-8">
      Контакты и реквизиты СТО МосСервис
    </h1>

    <!-- Top Grid: Contacts & Map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
      <!-- Contact Details Box -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-dark-900 p-6 sm:p-8 rounded-3xl border border-slate-800 space-y-6 shadow-xl">
          <div class="flex items-start space-x-4">
            <div class="w-10 h-10 rounded-xl bg-primary-500/20 text-primary-500 flex items-center justify-center shrink-0">
              <MapPin class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Адрес сервиса</h3>
              <a href={siteConfig.maps.yandex} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-white mt-1 block hover:text-primary-400 transition">
                {siteConfig.address.full}
              </a>
              <div class="flex space-x-3 mt-2 text-xs font-semibold">
                <a href={siteConfig.maps.yandex} target="_blank" rel="noopener noreferrer" class="text-red-400 hover:underline">Яндекс Маршрут →</a>
                <a href={siteConfig.maps.google} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">Google Маршрут →</a>
              </div>
            </div>
          </div>

          <div class="flex items-start space-x-4 pt-4 border-t border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-accent-500/20 text-accent-500 flex items-center justify-center shrink-0">
              <Phone class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Телефон приёмки</h3>
              <a href={`tel:${siteConfig.phoneClean}`} class="text-lg font-black text-white block mt-1 hover:text-primary-400 transition">
                {siteConfig.phonePrimary}
              </a>
              <span class="text-xs text-emerald-400 font-medium">Без выходных</span>
            </div>
          </div>

          <div class="flex items-start space-x-4 pt-4 border-t border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
              <Clock class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Режим работы</h3>
              <p class="text-sm font-bold text-white mt-1">{siteConfig.workingHours}</p>
            </div>
          </div>

          <div class="flex items-start space-x-4 pt-4 border-t border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Электронная почта</h3>
              <p class="text-sm font-bold text-white mt-1">{siteConfig.email}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Map Banner with Pin -->
      <div class="lg:col-span-7 bg-dark-900 rounded-3xl overflow-hidden border border-slate-800 min-h-[380px] relative shadow-xl">
        <iframe 
          title="Схема проезда СТО МосСервис с пином"
          src={mapWidgetUrl}
          class="w-full h-full min-h-[380px] border-0" 
          allowfullscreen="true"
        ></iframe>

        <!-- Map Location Badge -->
        <div class="absolute bottom-4 left-4 right-4 bg-dark-950/90 backdrop-blur border border-slate-800 p-3.5 rounded-2xl flex items-center justify-between text-xs">
          <div class="flex items-center space-x-2">
            <MapPin class="w-4 h-4 text-red-500 shrink-0" />
            <span class="text-white font-bold">{siteConfig.address.full}</span>
          </div>
          <a href={siteConfig.maps.yandex} target="_blank" rel="noopener noreferrer" class="bg-primary-500 hover:bg-primary-400 text-slate-950 font-bold px-3 py-1.5 rounded-lg transition shrink-0">
            Маршрут
          </a>
        </div>
      </div>
    </div>

    <!-- Requisites Section (Юридические данные ООО УпакПринтСервис) -->
    <div class="bg-dark-900 p-6 sm:p-10 rounded-3xl border border-slate-800 shadow-xl">
      <div class="flex items-center space-x-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-primary-500/20 text-primary-500 flex items-center justify-center">
          <Building2 class="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-xl font-bold text-white">Реквизиты компании</h2>
          <p class="text-xs text-slate-400">Информация для юридических лиц и безналичных расчетов</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-xs sm:text-sm">
        <div class="bg-dark-950 p-5 rounded-2xl border border-slate-800/80">
          <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block mb-1">Юридическое наименование</span>
          <span class="text-white font-extrabold text-base block">{siteConfig.legalName}</span>
          <span class="text-xs text-slate-400 mt-2 block">УНП: <strong class="text-slate-200">{siteConfig.unp}</strong></span>
        </div>

        <div class="bg-dark-950 p-5 rounded-2xl border border-slate-800/80">
          <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block mb-1">Расчетный счет (IBAN)</span>
          <span class="text-emerald-400 font-mono font-bold text-sm block tracking-wide select-all">{siteConfig.bankDetails.account}</span>
          <span class="text-xs text-slate-400 mt-2 block">Валюта: <strong>BYN (Белорусский рубль)</strong></span>
        </div>

        <div class="bg-dark-950 p-5 rounded-2xl border border-slate-800/80">
          <span class="text-xs text-slate-400 font-bold uppercase tracking-wider block mb-1">Банк обслуживания</span>
          <span class="text-white font-bold block">{siteConfig.bankDetails.bankName}</span>
          <span class="text-xs text-slate-400 mt-2 block">BIC: <strong class="text-slate-200">{siteConfig.bankDetails.bic}</strong></span>
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
        <div class="flex items-center space-x-2">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Выделяем НДС 20% при безналичном расчете с организациями</span>
        </div>
        <a href={`mailto:${siteConfig.email}`} class="text-primary-400 hover:underline font-semibold">
          Запросить счет-фактуру: {siteConfig.email}
        </a>
      </div>
    </div>
  </div>
</Layout>
