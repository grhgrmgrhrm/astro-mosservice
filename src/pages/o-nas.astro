---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/data/siteConfig';
import { Award, ShieldCheck, Wrench, Users, CheckCircle2 } from 'lucide-astro';
---

<Layout title="О компании | СТО МАСервис в Минске" description="МАСервис — специализированный сервисный центр по ремонту топливной аппаратуры дизелей в Минске с 2012 года.">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'О компании' }]} />

    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-6">
        О сервисном центре <span class="text-primary-500">МАСервис</span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8">
        СТО «МАСервис» работает на рынке автосервисных услуг Минска более 14 лет. Мы специализируемся исключительно на диагностике, чистке и капитальном ремонте элементов топливной аппаратуры бензиновых и дизельных систем Common Rail.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 text-center">
          <div class="text-3xl font-black text-primary-500 mb-1">14+</div>
          <div class="text-xs text-slate-400">Лет опыта в ремонте ТНВД</div>
        </div>
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 text-center">
          <div class="text-3xl font-black text-accent-500 mb-1">15 000+</div>
          <div class="text-xs text-slate-400">Отремонтированных форсунок</div>
        </div>
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 text-center">
          <div class="text-3xl font-black text-emerald-400 mb-1">12 мес</div>
          <div class="text-xs text-slate-400">Гарантия</div>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-white mb-4">Наше оборудование</h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">
        Мастерская оснащена современными компьютерными исследовательскими стендами Bosch EPS и Hartridge, позволяющими измерять гидроплотность, форму факела распыла, фазы предвпрыска и генерировать оригинальные коды коррекции (IMA, QR, C2I/C3I).
      </p>
    </div>
  </div>
</Layout>
